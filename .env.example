# Копия для рабочей машины: cp .env.example .env
# Файл читается сервером через dotenv (server/index.ts) и Vite — переменные с
# префиксом VITE_ уходят в сборку клиента, остальные видит только сервер.
# Все значения ниже совпадают с умолчаниями в коде: пустой .env ничего не ломает.

# ── Сервер ──────────────────────────────────────────────────────────────────

# Порт API. Клиент в dev-режиме ходит на него через прокси Vite (vite.config.ts),
# поэтому менять порт нужно в двух местах сразу.
PORT=3001

# Файл базы. По умолчанию — server/data/govfin.db рядом с кодом. В проде
# выносите на диск, который попадает в резервное копирование:
# DB_PATH=/var/lib/buhportal/govfin.db
DB_PATH=

# Каталог вложений. По умолчанию — uploads рядом с файлом базы. Держите их на
# одном томе: копия базы без файлов бесполезна, файлы без базы — тоже.
# UPLOAD_DIR=/var/lib/buhportal/uploads
UPLOAD_DIR=

# Каталог копий базы. По умолчанию — backups рядом с базой; хранятся последние
# семь. Отдельный диск здесь лучше того же самого.
# BACKUP_DIR=/var/backups/buhportal
BACKUP_DIR=

# ── Доступ ──────────────────────────────────────────────────────────────────

# Origin'ы, которым разрешён доступ к API из браузера. Несколько — через
# запятую, без завершающего слэша. По умолчанию http://localhost:3000.
# CORS_ORIGIN=https://buh.company.kz,https://buh.company.local
CORS_ORIGIN=

# Заполняйте, только если API стоит за nginx или облачным балансировщиком:
# иначе адрес клиента подделывается заголовком X-Forwarded-For и лимит попыток
# входа обходится. Число — сколько прокси перед сервером, «loopback» — прокси
# на той же машине.
# TRUST_PROXY=1
TRUST_PROXY=

# ── Опасное и временное ─────────────────────────────────────────────────────

# RESET_DB=1 сносит все таблицы и пересобирает базу с демо-данными. Копия
# снимается автоматически, но в проде этой строки быть не должно.
RESET_DB=

# Показывать на странице входа список демо-доступов с паролем. Только для
# демонстрации и локальной разработки — в проде оставьте пустым.
VITE_SHOW_DEMO_LOGINS=
